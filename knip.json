{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.ts",
    "src/app.module.ts",
    "src/**/*.module.ts",
    "prisma.config.ts",
    "prisma/**/*.{ts,cjs,js}",
    "scripts/run-checks.mjs",
    "scripts/code/*.cjs",
    "test/**/*.{ts,js}"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.{mjs,cjs,js}",
    "prisma/**/*.{ts,cjs,js}",
    "prisma.config.ts"
  ],
  "ignore": [
    "src/generated/**",
    "dist/**",
    "coverage/**",
    "api/**",
    "scripts/.temp-jscpd/**"
  ],
  "ignoreDependencies": [
    "@nestjs/cli",
    "@nestjs/schematics",
    "@prisma/client",
    "@types/multer",
    "multer",
    "swagger-ui-express",
    "ts-loader",
    "ts-node",
    "tsconfig-paths",
    "source-map-support",
    "knip",
    "jscpd",
    "@babel/parser",
    "@babel/traverse",
    "prettier",
    "eslint-config-prettier",
    "eslint-plugin-prettier"
  ],
  "ignoreBinaries": ["prisma"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  }
}
